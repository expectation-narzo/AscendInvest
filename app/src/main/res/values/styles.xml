<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundedInput">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
    <style name="CheckboxShape">
        <item name="cornerSize">6dp</item>
    </style>
    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ProfessionalChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg_selector</item>
        <item name="chipSurfaceColor">@color/white</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeColor">@color/chip_stroke_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="chipIconVisible">false</item>
        <item name="rippleColor">@color/primary_purple</item>
        <item name="showMotionSpec">@null</item>
        <item name="hideMotionSpec">@null</item>
    </style>
</resources>