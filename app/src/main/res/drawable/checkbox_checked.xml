<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Blue Background with fixed size -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="18dp"
                android:height="18dp" />

            <solid android:color="@color/primary_purple"/>

            <stroke
                android:width="1dp"
                android:color="@color/primary_purple"/>

            <corners android:radius="3dp"/>
        </shape>
    </item>

    <!-- Small White Tick Centered -->
    <item
        android:gravity="center"
        android:width="10dp"
        android:height="10dp"
        android:drawable="@drawable/checkbox_tick"/>
        
</layer-list>