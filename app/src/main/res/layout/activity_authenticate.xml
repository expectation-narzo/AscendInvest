<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F8FAFC">

    <!-- Advanced Animated Background Mesh -->
    <View
        android:id="@+id/mesh_glow_1"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginTop="-300dp"
        android:layout_marginEnd="-300dp"
        android:background="@drawable/circle_bg"
        android:backgroundTint="#156C5CE7"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/mesh_glow_2"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_marginBottom="-250dp"
        android:layout_marginStart="-250dp"
        android:background="@drawable/circle_bg"
        android:backgroundTint="#0A6C5CE7"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/auth_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="0dp">

            <!-- High-End Decorative Header -->
            <FrameLayout
                android:id="@+id/logo_holder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/logo_glow"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#EEF2FF" />

                <ImageView
                    android:id="@+id/auth_logo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_logo_without_bg"
                    app:tint="@color/primary_purple" />
            </FrameLayout>

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ascend Invest"
                android:textSize="28sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="900"
                android:textColor="#1E293B"
                android:letterSpacing="0.05"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/logo_holder"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/auth_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Elite Capital Management"
                android:textSize="12sp"
                android:fontFamily="@font/public_sans"
                android:textColor="#94A3B8"
                android:textAllCaps="true"
                android:letterSpacing="0.2"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/auth_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/auth_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginVertical="30dp"
                app:cardElevation="32dp"
                app:cardCornerRadius="48dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#F8FAFC"
                app:layout_constraintTop_toBottomOf="@id/auth_subtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                >

                <LinearLayout
                    android:id="@+id/page_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="30dp"
                    android:clipChildren="false">

                    <!-- Welcome View -->
                    <LinearLayout
                        android:id="@+id/welcomePage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Secure Your\nWealth"
                            android:textSize="32sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="900"
                            android:textColor="#1E293B"
                            android:lineSpacingMultiplier="0.9" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Institutional grade infrastructure for the modern investor. Smart, simple, and secured by encryption."
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.6"
                            android:fontFamily="@font/public_sans"
                            android:textColor="#64748B" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_goto_signin"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="48dp"
                            android:text="Sign In to Portal"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textFontWeight="700"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/primary_purple"
                            app:elevation="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_goto_signup"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="16dp"
                            android:text="Register Account"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:textColor="@color/primary_purple"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#F8FAFC"
                            app:elevation="0dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="#E2E8F0" />

                    </LinearLayout>

                    <!-- Sign In Page -->
                    <LinearLayout
                        android:id="@+id/signInPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome Back"
                            android:textSize="22sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="#1E293B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Authenticate to access your portfolio"
                            android:textSize="14sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="#64748B" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayout1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:hint="Email Address"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_email"
                            app:startIconTint="#000000"
                            android:textColorHint="#000000"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/loginUsernameEmail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayout2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Access Password"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_pass"
                            app:passwordToggleTint="#000000"
                            app:passwordToggleEnabled="true"
                            android:textColorHint="#000000"
                            app:startIconTint="#000000"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/loginPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp">
                            <CheckBox
                                android:id="@+id/checkbox1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Keep active"
                                android:textSize="13sp"
                                android:textColor="#64748B"
                                android:layout_alignParentStart="true"
                                android:layout_centerVertical="true" />
                            <TextView
                                android:id="@+id/textview12"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lost access?"
                                android:textSize="13sp"
                                android:fontFamily="@font/public_sans"
                                android:textFontWeight="700"
                                android:textColor="@color/primary_purple"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true" />
                        </RelativeLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button1"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_marginTop="32dp"
                            android:text="Secure Login"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/primary_purple"
                            app:elevation="8dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/signin_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/primary_purple"
                            app:trackColor="#EEF2FF"
                            app:trackCornerRadius="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New member?"
                                android:textSize="14sp"
                                android:textColor="#64748B" />
                            <TextView
                                android:id="@+id/btn_goto_signup_link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Open account"
                                android:textSize="14sp"
                                android:fontFamily="@font/public_sans"
                                android:textFontWeight="700"
                                android:textColor="@color/primary_purple"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_back_to_welcome_from_signin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_gravity="center"
                            android:text="Cancel"
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="#94A3B8"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />
                    </LinearLayout>

                    <!-- Reset Password Page -->
                    <LinearLayout
                        android:id="@+id/resentPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Account Recovery"
                            android:textSize="22sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="#1E293B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Submit your email for recovery instructions"
                            android:textSize="14sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="#64748B" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayout3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:hint="Registered Email"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_email"
                            app:startIconTint="#000000"
                            android:textColorHint="#000000"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edittext3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button2"
                            android:layout_width="match_parent"
                            android:textColor="#FFFFFF"
                            android:layout_height="60dp"
                            android:layout_marginTop="32dp"
                            android:text="Dispatch Link"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/primary_purple"
                            app:elevation="8dp" />

                        <TextView
                            android:id="@+id/textview20"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:layout_gravity="center"
                            android:text="Return to Login"
                            android:textSize="14sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="@color/primary_purple"
                            android:textAllCaps="true"
                            android:letterSpacing="0.05" />
                    </LinearLayout>

                    <!-- Sign Up Page -->
                    <LinearLayout
                        android:id="@+id/Createpage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Join the Alpha"
                            android:textSize="22sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="#1E293B" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Start your compounding journey now"
                            android:textSize="14sp"
                            android:fontFamily="@font/public_sans"
                            android:textColor="#64748B" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayout6"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:hint="Investor Full Name"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#000000"
                            android:textColorHint="#000000"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edittext6"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPersonName"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayout4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Professional Email"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_email"
                            app:startIconTint="#000000"
                            android:textColorHint="#000000"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edittext4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayout5"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Create Vault Password"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_pass"
                            app:startIconTint="#000000"
                            app:passwordToggleTint="#000000"
                            android:textColorHint="#000000"
                            app:passwordToggleEnabled="true"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edittext5"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinputlayoutReferral"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:hint="Affiliate Code (Optional)"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/primary_purple"
                            app:hintTextColor="@color/primary_purple"
                            app:startIconDrawable="@drawable/ic_link"
                            app:startIconTint="#000000"
                            android:textColorHint="#000000"
                            app:boxCornerRadiusTopStart="20dp"
                            app:boxCornerRadiusTopEnd="20dp"
                            app:boxCornerRadiusBottomStart="20dp"
                            app:boxCornerRadiusBottomEnd="20dp">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edittextReferral"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textSize="15sp"
                                android:textColor="#1E293B"
                                android:padding="18dp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <CheckBox
                            android:id="@+id/checkbox2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="I accept terms and conditions"
                            android:textSize="13sp"
                            android:textColor="#64748B" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button3"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="32dp"
                            android:textColor="#FFFFFF"
                            android:text="Activate Account"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/primary_purple"
                            app:elevation="8dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/signup_progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/primary_purple"
                            app:trackColor="#EEF2FF"
                            app:trackCornerRadius="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:gravity="center"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Already verified?"
                                android:textSize="14sp"
                                android:textColor="#64748B" />
                            <TextView
                                android:id="@+id/btn_goto_signin_link"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" Sign in"
                                android:textSize="14sp"
                                android:fontFamily="@font/public_sans"
                                android:textFontWeight="700"
                                android:textColor="@color/primary_purple"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_back_to_welcome_from_signup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_gravity="center"
                            android:text="Cancel"
                            android:textSize="12sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="#94A3B8"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />
                    </LinearLayout>

                    <!-- Verification Page -->
                    <LinearLayout
                        android:id="@+id/verificationPage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Verify Identity"
                            android:textSize="24sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="900"
                            android:textColor="#1E293B" />

                        <TextView
                            android:id="@+id/tv_verification_msg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="A verification link was sent to your email. Please verify it to activate your account."
                            android:textSize="14sp"
                            android:lineSpacingMultiplier="1.5"
                            android:fontFamily="@font/public_sans"
                            android:textColor="#64748B" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_check_verification"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="40dp"
                            android:text="I have verified"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textColor="#FFFFFF"
                            android:textFontWeight="700"
                            app:cornerRadius="20dp"
                            app:backgroundTint="@color/primary_purple"
                            app:elevation="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_resend_verification"
                            android:layout_width="match_parent"
                            android:layout_height="64dp"
                            android:layout_marginTop="16dp"
                            android:text="Resend Link"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textFontWeight="700"
                            android:textColor="@color/primary_purple"
                            app:cornerRadius="20dp"
                            app:backgroundTint="#F8FAFC"
                            app:elevation="0dp"
                            app:strokeWidth="1.5dp"
                            app:strokeColor="#E2E8F0" />

                        <TextView
                            android:id="@+id/btn_back_from_verification"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:layout_gravity="center"
                            android:text="Use a different email"
                            android:textSize="13sp"
                            android:fontFamily="@font/public_sans"
                            android:textFontWeight="800"
                            android:textColor="#94A3B8"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
