<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="16dp"
    android:background="@drawable/item_metric_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_purple"
            android:padding="6dp"
            android:src="@drawable/ic_dollar"
            app:tint="#6C5CE7" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Earnings"
            android:fontFamily="@font/public_sans"
            android:textFontWeight="500"
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_earning_metric_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="$0"
        android:textColor="#333333"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="600"
        android:textSize="20sp"
         />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_earning_metric"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:progress="0"
        app:indicatorColor="#6C5CE7"
        app:trackColor="#F0F0F0"
        app:trackCornerRadius="10dp"
        app:trackThickness="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_cyan"
            android:padding="6dp"
            android:src="@drawable/ic_clock"
            app:tint="#00CED1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Profit"
            android:fontFamily="@font/public_sans"
            android:textFontWeight="500"
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_profit_metric_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="$0"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="600"
        android:textColor="#333333"
        android:textSize="20sp"
        />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/pb_profit_metric"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:progress="0"
        app:indicatorColor="#00CED1"
        app:trackColor="#F0F0F0"
        app:trackCornerRadius="10dp"
        app:trackThickness="6dp" />

</LinearLayout>