<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="start"
    android:background="#FFFFFF"
    android:id="@+id/nav_main"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Premium Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:background="@drawable/bg_auth">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/drawer_profile_img"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_launcher"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:background="@color/white"
                android:padding="2dp"
                app:strokeWidth="2.5dp"
                app:strokeColor="@color/primary_purple"
                android:elevation="4dp" />

            <TextView
                android:id="@+id/drawer_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="User Alpha"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="800"
                android:textSize="18sp"
                android:textColor="#1E293B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#22C55E" />

                <TextView
                    android:id="@+id/drawer_userid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="ID: AS99201"
                    android:fontFamily="@font/public_sans"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:textFontWeight="600" />
            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="-20dp"
            android:src="@drawable/ic_logo_without_bg"
            android:alpha="0.05"
            android:rotation="-15" />

    </RelativeLayout>

    <!-- Menu Items -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="MAIN MENU"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/dashboard_btn"
                style="@style/NavMenuItem"
                android:background="@drawable/menu_item_selected_bg">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    android:src="@drawable/ic_dashboard"
                    app:tint="@color/primary_purple" />
                <TextView
                    style="@style/NavMenuText"
                    android:text="Overview"
                    android:textColor="@color/primary_purple"
                    android:textFontWeight="700" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deposit_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    android:src="@drawable/ic_deposit"
                    app:tint="#64748B" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="Deposits" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/withdraw_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    app:tint="#64748B"
                    android:src="@drawable/ic_withdraw" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="Withdrawal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/p2p_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    app:tint="#64748B"
                    android:src="@drawable/ic_p2p" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="P2P Transfer" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginVertical="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="EARNINGS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/plan_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    app:tint="#64748B"
                    android:src="@drawable/ic_plan" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="Market Plans" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/refer_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    app:tint="#64748B"
                    android:src="@drawable/ic_link" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="Referrals" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/team_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    app:tint="#64748B"
                    android:src="@drawable/ic_team" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="My Network" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F1F5F9"
                android:layout_marginVertical="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="12dp"
                android:text="OTHERS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <LinearLayout
                android:id="@+id/support_btn"
                style="@style/NavMenuItem">
                <ImageView
                    style="@style/NavMenuIcon"
                    android:padding="3dp"
                    app:tint="#64748B"
                    android:src="@drawable/ic_support" />
                <TextView
                    style="@style/NavMenuText"
                    android:textColor="#64748B"
                    android:text="Help Center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/logout_btn"
            style="@style/NavMenuItem"
            android:background="@drawable/status_failed_bg"
            android:backgroundTint="#FFF1F2">
            <ImageView
                style="@style/NavMenuIcon"
                android:src="@drawable/ic_logout"
                app:tint="#F43F5E" />
            <TextView
                style="@style/NavMenuText"
                android:text="Sign Out"
                android:textColor="#F43F5E"
                android:textFontWeight="700" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
