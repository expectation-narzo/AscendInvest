<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Post Sell Advertisement"
        android:textColor="#1E293B"
        android:textSize="20sp"
        android:textFontWeight="800"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="List your unlocked profit for others to buy via UPI. Funds will be locked in escrow."
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Amount to Sell (USDT)"
        app:boxCornerRadiusTopStart="12dp"
        android:textColorHint="#64748B"
        app:boxStrokeColor="@color/primary_purple"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ad_amount"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Price per USDT (INR)"
        android:textColorHint="#64748B"
        app:boxStrokeColor="@color/primary_purple"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ad_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:inputType="numberDecimal"
            android:text="91" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Minimum Order Limit (USDT)"
        app:boxCornerRadiusTopStart="12dp"
        android:textColorHint="#64748B"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxStrokeColor="@color/primary_purple"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ad_min_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#000000"
            android:inputType="numberDecimal"
            android:text="10" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Your UPI ID (For receiving payment)"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxStrokeColor="@color/primary_purple"
        android:textColorHint="#64748B"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="24dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_ad_upi"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_post_ad_fee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Platform Fee: 0%"
        android:textColor="@color/error_red"
        android:textSize="12sp"
        android:textFontWeight="600"
        android:gravity="end"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_post_ad"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="List USDT for Sale"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:textFontWeight="700"
        app:cornerRadius="14dp"
        app:backgroundTint="@color/primary_purple" />

</LinearLayout>
