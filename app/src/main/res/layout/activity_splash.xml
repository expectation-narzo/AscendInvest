<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_pattern">

    <!-- Decorative Center Hub -->
    <FrameLayout
        android:id="@+id/center_hub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <View
            android:id="@+id/logo_bg_circle"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#FFFFFF"
            android:elevation="12dp"
            android:alpha="0"
            android:scaleX="0.5"
            android:scaleY="0.5" />

        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logo_without_bg"
            android:elevation="13dp"
            android:alpha="0"
            android:scaleX="0.5"
            android:scaleY="0.5" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/title_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/center_hub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASCEND INVEST"
            android:textColor="#1E293B"
            android:textSize="28sp"
            android:fontFamily="@font/public_sans"
            android:textFontWeight="900"
            android:letterSpacing="0.2"
            android:alpha="0" />

        <TextView
            android:id="@+id/tv_splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Elite Capital Management"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.3"
            android:fontFamily="@font/public_sans"
            android:alpha="0" />
    </LinearLayout>

    <!-- Bottom Branding -->
    <LinearLayout
        android:id="@+id/bottom_branding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splash_progress"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/primary_purple"
            app:trackColor="#EEF2FF"
            app:trackCornerRadius="10dp"
            app:trackThickness="3dp"
            android:alpha="0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Secure • Strategic • Smart"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.25"
            android:fontFamily="@font/public_sans" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
