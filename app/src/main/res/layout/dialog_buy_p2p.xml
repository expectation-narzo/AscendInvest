<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:id="@+id/tv_buy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Buy USDT"
        android:textColor="#1E293B"
        android:textSize="20sp"
        android:textFontWeight="800"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_buy_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the amount you want to buy. The funds will be held in escrow for security."
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F8FAFC"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        android:layout_marginBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Price"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tv_buy_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.00"
                    android:textColor="#1E293B"
                    android:textFontWeight="700"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Available"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tv_buy_available"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 USDT"
                    android:textColor="#1E293B"
                    android:textFontWeight="700"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:hint="Amount to Buy (USDT)"
        app:boxCornerRadiusTopStart="12dp"
        android:textColorHint="#64748B"
        app:boxStrokeColor="@color/primary_purple"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        android:layout_marginBottom="8dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_buy_amount"
            android:layout_width="match_parent"
            android:textColor="#000000"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_buy_receive_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You will receive: 0.00 USDT"
        android:textColor="@color/secondary_green"
        android:textSize="12sp"
        android:textFontWeight="600"
        android:gravity="start"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tv_buy_fiat_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: ₹0.00"
        android:textColor="@color/primary_purple"
        android:textSize="14sp"
        android:textFontWeight="700"
        android:gravity="end"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm_buy"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Buy USDT"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:textFontWeight="700"
        app:cornerRadius="14dp"
        app:backgroundTint="@color/secondary_green" />

</LinearLayout>
