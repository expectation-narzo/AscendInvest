<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="10dp"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:cardMaxElevation="12dp"
        app:cardBackgroundColor="#00000000">

        <RelativeLayout
            android:id="@+id/rlBannerBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_banner_gold">

            <!-- Premium Decorative Elements -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Abstract Glow -->
                <View
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="-100dp"
                    android:layout_marginTop="-100dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#40FFFFFF"
                    android:alpha="0.3" />

                <!-- Large Background Icon -->
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="-40dp"
                    android:layout_marginBottom="-40dp"
                    android:alpha="0.12"
                    android:rotation="-15"
                    android:src="@drawable/ic_logo_without_bg"
                    app:tint="#FFFFFF" />

                <!-- Subtle Grid Pattern Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_grey"
                    android:alpha="0.05" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/status_purple_bg"
                    android:backgroundTint="#33FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="4dp"
                        android:layout_height="4dp"
                        android:background="@drawable/circle_bg"
                        android:backgroundTint="#FFFFFF" />

                    <TextView
                        android:id="@+id/tvBannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="ELITE OPPORTUNITY"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.15"
                        android:textFontWeight="900"
                        android:textSize="8sp"
                        android:fontFamily="@font/public_sans" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBannerPlanName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/public_sans"
                    android:text="Super Gold Alpha"
                    android:textColor="#FFFFFF"
                    android:textFontWeight="900"
                    android:textSize="20sp"
                    android:lineSpacingExtra="-2dp"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="4"
                    android:shadowRadius="8" />

                <TextView
                    android:id="@+id/tvBannerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/public_sans"
                    android:text="Premium Tier • High Yield Strategic"
                    android:textColor="#F8FAFC"
                    android:textSize="11sp"
                    android:alpha="0.95"
                    android:textFontWeight="600" />

                <!-- Separator Line -->
                <View
                    android:layout_width="30dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="#FFFFFF"
                    android:alpha="0.6" />

                <!-- Metric Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STAKE"
                            android:textColor="#F1F5F9"
                            android:alpha="0.8"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvBannerInvest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/public_sans"
                            android:text="$500"
                            android:textColor="#FFFFFF"
                            android:textFontWeight="600"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DAILY"
                            android:textColor="#F1F5F9"
                            android:alpha="0.8"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvBannerDaily"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/public_sans"
                            android:text="3.2%"
                            android:textColor="#FFFFFF"
                            android:textFontWeight="600"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ROI"
                            android:textColor="#F1F5F9"
                            android:alpha="0.8"
                            android:textStyle="bold"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvBannerReturn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/public_sans"
                            android:text="0%"
                            android:textColor="#FFFFFF"
                            android:textFontWeight="600"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
