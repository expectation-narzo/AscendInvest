<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp"
    android:clipToPadding="false">

    <!-- Profile Image (Left) -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_profile"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_logo"
        android:padding="0dp"
        android:background="#FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#F1F5F9"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <!-- Receiver Message (Left) -->
        <LinearLayout
            android:id="@+id/ll_receiver_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginEnd="48dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_receiver_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:text="Sender Name"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textFontWeight="700"
                android:fontFamily="@font/public_sans" />

            <LinearLayout
                android:id="@+id/rl_receiver_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_receiver"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <!-- Reply Preview (Incoming) -->
                <LinearLayout
                    android:id="@+id/ll_reply_receiver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#F8FAFC"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="@color/primary_purple"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tv_reply_user_receiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="User"
                        android:textColor="@color/primary_purple"
                        android:textSize="11sp"
                        android:textFontWeight="800" />
                    <TextView
                        android:id="@+id/tv_reply_msg_receiver"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Message preview"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_receiver_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ll_reply_receiver"
                    android:text="Message here"
                    android:textColor="#1E293B"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/public_sans" />

                <TextView
                    android:id="@+id/tv_receiver_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tv_receiver_msg"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="4dp"
                    android:text="12:00 PM"
                    android:layout_gravity="end"
                    android:textSize="9sp"
                    android:textColor="#94A3B8"
                    android:fontFamily="@font/public_sans" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sender Message (Right) -->
        <LinearLayout
            android:id="@+id/ll_sender_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/rl_sender_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chat_sender"
                android:elevation="1dp"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <!-- Reply Preview (Outgoing) -->
                <LinearLayout
                    android:id="@+id/ll_reply_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#20FFFFFF"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#FFFFFF"
                        android:layout_marginBottom="4dp" />
                    <TextView
                        android:id="@+id/tv_reply_user_sender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Support"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textFontWeight="800" />
                    <TextView
                        android:id="@+id/tv_reply_msg_sender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Message preview"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sender_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/ll_reply_sender"
                    android:text="Admin message here"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/public_sans" />

                <TextView
                    android:id="@+id/tv_sender_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="end"
                    android:text="12:01 PM"
                    android:textSize="9sp"
                    android:textColor="#CCFFFFFF"
                    android:fontFamily="@font/public_sans" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
