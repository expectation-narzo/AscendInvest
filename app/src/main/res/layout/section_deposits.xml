<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/section_deposits"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone"
    android:background="@android:color/transparent"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Header Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financial Operations"
                android:textColor="@color/primary_purple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Deposit Funds"
                android:textColor="#1E293B"
                android:textSize="24sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="700" />
        </LinearLayout>

        <!-- Elegant Balance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Wallet Balance"
                        android:textColor="#64748B"
                        android:textSize="13sp"
                        android:fontFamily="@font/public_sans" />

                    <TextView
                        android:id="@+id/tv_deposit_wallet_balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="$0.00"
                        android:textColor="#1E293B"
                        android:textSize="28sp"
                        android:fontFamily="@font/public_sans"
                        android:textFontWeight="700" />
                </LinearLayout>

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/circle_bg"
                    android:backgroundTint="#F5F3FF"
                    android:padding="12dp"
                    android:src="@drawable/ic_wallet"
                    app:tint="@color/primary_purple" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Deposit Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textColor="#1E293B"
                    android:textSize="16sp"
                    android:textFontWeight="600"
                    android:layout_marginBottom="20dp" />

                <!-- Network Switcher Visual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/transaction_item_bg"
                    android:backgroundTint="#F8F9FA"
                    android:padding="16dp"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_usdt" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tether USDT"
                            android:textColor="#1E293B"
                            android:textSize="14sp"
                            android:textFontWeight="600" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Network: BEP20 (BNB Smart Chain)"
                            android:textColor="#64748B"
                            android:textSize="12sp" />
                    </LinearLayout>


                </LinearLayout>

                <!-- Professional QR Integration -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp"
                    android:background="@drawable/edit_text_bg"
                    android:backgroundTint="#F8FAFC"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="10dp"
                        app:strokeWidth="0dp"
                        app:strokeColor="#FFFFFF">
                        <ImageView
                            android:id="@+id/iv_qr_code"
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:scaleType="fitCenter" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tv_my_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Fetching Address..."
                        android:textColor="#475569"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:background="@drawable/edit_text_bg"
                        android:backgroundTint="#FFFFFF"
                        android:padding="14dp"
                        android:letterSpacing="0.02" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_copy_address"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Copy Secure Address"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_purple"
                        app:icon="@drawable/ic_link"
                        app:iconSize="18dp"
                        app:iconPadding="8dp" />
                </LinearLayout>

                <!-- Input Fields with Unified Style -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Transaction Information"
                    android:textColor="#1E293B"
                    android:textSize="15sp"
                    android:textFontWeight="600"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:textColorHint="@color/black"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/primary_purple"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/deposit_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Deposit Amount (USDT)"
                        android:inputType="numberDecimal"
                        android:textColor="#1E293B"
                        android:textColorHint="@color/black"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:textColorHint="@color/black"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/primary_purple"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/user_wallet_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Sender's Wallet Address (Optional)"
                        android:inputType="text"
                        android:textColor="#1E293B"
                        android:textColorHint="@color/black"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:textColorHint="@color/black"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="@color/primary_purple"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/transaction_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Transaction ID / Hash"
                        android:inputType="text"
                        android:textColor="#1E293B"
                        android:textColorHint="@color/black"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deposit_button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Submit Deposit Confirmation"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/secondary_green"
                    app:cornerRadius="14dp"
                    app:elevation="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="* Funds will be credited after network confirmation (typically 5-10 minutes). Minimum deposit is $10.00."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:textAlignment="center"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- History Section Header -->
        <LinearLayout
            android:id="@+id/history_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deposit History"
                android:textColor="#1E293B"
                android:textSize="18sp"
                android:textFontWeight="700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIEW ALL"
                android:textColor="@color/primary_purple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_deposit_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
