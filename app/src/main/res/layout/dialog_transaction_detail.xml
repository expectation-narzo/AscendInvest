<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/transaction_detail_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_bg_green"
            android:padding="12dp"
            android:src="@drawable/ic_deposit"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/transaction_detail_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank Transfer Deposit"
                android:textColor="#2E2E2E"
                android:textSize="20sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="600" />

            <TextView
                android:id="@+id/transaction_detail_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+$500.00"
                android:textColor="#28C76F"
                android:textSize="24sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="700"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/transaction_detail_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Success"
            android:textColor="#28C76F"
            android:textSize="14sp"
            android:background="@drawable/status_success_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

    </LinearLayout>

    <!-- Transaction Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/transaction_item_bg"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transaction Details"
            android:textColor="#2E2E2E"
            android:textSize="18sp"
            android:fontFamily="@font/public_sans"
            android:textFontWeight="600"
            android:layout_marginBottom="16dp" />

        <!-- Transaction ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Transaction ID"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/transaction_detail_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TXN123456789"
                android:textColor="#2E2E2E"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="500" />

        </LinearLayout>

        <!-- Date & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Date and Time"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/transaction_detail_datetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="May 1, 2026 • 2:30 PM"
                android:textColor="#2E2E2E"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="500" />

        </LinearLayout>

        <!-- Payment Method -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Payment Method"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/transaction_detail_method"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bank Transfer"
                android:textColor="#2E2E2E"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="500" />

        </LinearLayout>

        <!-- Account/Recipient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Account"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/transaction_detail_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="****1234"
                android:textColor="#2E2E2E"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="500" />

        </LinearLayout>

        <!-- Processing Fee -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Processing Fee"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/transaction_detail_fee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$2.50"
                android:textColor="#2E2E2E"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="500" />

        </LinearLayout>

        <!-- Net Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Net Amount"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/transaction_detail_net"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$497.50"
                android:textColor="#2E2E2E"
                android:textSize="14sp"
                android:fontFamily="@font/public_sans"
                android:textFontWeight="500" />

        </LinearLayout>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_download_receipt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Download Receipt"
            android:background="@drawable/button_bg"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/btn_close_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:background="@android:color/transparent"
            android:textColor="#007AFF"
            android:textSize="14sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

</LinearLayout>
