<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="10dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#FFFFFF"
    android:layout_margin="14dp"
    android:layout_width="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sales Overview"
        android:textColor="#757575"
        android:textSize="17sp"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="500"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvPercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+18.2%"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="600"
        android:textColor="#4CAF50"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTotalValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="$42.5k"
        android:alpha="0.9"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="600"
        android:textColor="#444"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/iconOrder"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:padding="6dp"
        app:layout_constraintTop_toBottomOf="@id/tvTotalValue"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvOrderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="Order"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="500"
        android:textColor="#757575"
        app:layout_constraintTop_toTopOf="@id/iconOrder"
        app:layout_constraintBottom_toBottomOf="@id/iconOrder"
        app:layout_constraintStart_toEndOf="@id/iconOrder" />

    <TextView
        android:id="@+id/tvOrderPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="62.2%"
        android:alpha="0.9"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="600"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/iconOrder"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6,440"
        android:fontFamily="@font/public_sans"
        android:textFontWeight="400"
        android:textColor="#BDBDBD"
        app:layout_constraintTop_toBottomOf="@id/tvOrderPercent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#EEEEEE"
        app:layout_constraintTop_toTopOf="@id/iconOrder"
        app:layout_constraintBottom_toBottomOf="@id/tvOrderPercent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="VS"
           android:fontFamily="@font/public_sans"
            android:textFontWeight="500"
            android:gravity="center"
            android:textSize="10sp"
            android:textColor="#BDBDBD"
            app:layout_constraintTop_toTopOf="@id/divider"
            app:layout_constraintBottom_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="@id/divider"
            app:layout_constraintEnd_toEndOf="@id/divider" />

        <ProgressBar
            android:id="@+id/comparisonBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="24dp"
            android:progress="62"
            app:layout_constraintTop_toBottomOf="@id/tvOrderPercent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>