<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="12dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title & Category Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/llBadges"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPlanName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/public_sans"
                        android:text="Plan"
                        android:textColor="#1E293B"
                        android:textSize="17sp"
                        android:textFontWeight="800" />

                    <TextView
                        android:id="@+id/tvPlanDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/public_sans"
                        android:text=""
                        android:textColor="#64748B"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llBadges"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_purple_bg"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text=""
                        android:textColor="@color/primary_purple"
                        android:textSize="11sp"
                        android:textFontWeight="700"
                        android:textAllCaps="true"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvActiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_green_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="● ACTIVE"
                        android:textColor="#22C55E"
                        android:textSize="10sp"
                        android:textFontWeight="800"
                        android:visibility="gone" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Main Metrics Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TOTAL RETURNS"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />
                    <TextView
                        android:id="@+id/tvTotalProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/public_sans"
                        android:text="$0"
                        android:textColor="#1E293B"
                        android:textSize="18sp"
                        android:textFontWeight="800" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvProfitPercentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+0%"
                        android:textColor="#22C55E"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="yield"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textAllCaps="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- Secondary Metrics -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="@drawable/bg_icon_grey"
                android:backgroundTint="#F8FAFC">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Investment"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textFontWeight="600" />
                    <TextView
                        android:id="@+id/tvInvestAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$0"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textFontWeight="700" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E2E8F0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Daily"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textFontWeight="600" />
                    <TextView
                        android:id="@+id/tvDailyProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$0"
                        android:textColor="#22C55E"
                        android:textSize="14sp"
                        android:textFontWeight="700" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E2E8F0" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Duration"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textFontWeight="600" />
                    <TextView
                        android:id="@+id/tvDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 Days"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textFontWeight="700" />
                </LinearLayout>
            </LinearLayout>

            <!-- Active Plan Insights (Progress & Earned) -->
            <LinearLayout
                android:id="@+id/llActiveInsights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Earning Progress"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:textFontWeight="600" />
                    <TextView
                        android:id="@+id/tvEarnedSoFar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Earned: $45.00"
                        android:textColor="@color/primary_purple"
                        android:textSize="12sp"
                        android:textFontWeight="700" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbPlanProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:indicatorColor="@color/primary_purple"
                    app:trackColor="#F1F5F9"
                    app:trackCornerRadius="10dp"
                    app:trackThickness="8dp"
                    android:progress="35" />
            </LinearLayout>

            <!-- Actions -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnInvest"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/button_bg_purple"
                    android:fontFamily="@font/public_sans"
                    android:text="Activate Opportunity"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textFontWeight="700"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />

                <LinearLayout
                    android:id="@+id/llActivePlanActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnClaimProfit"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/button_bg_purple"
                        android:fontFamily="@font/public_sans"
                        android:text="Collect Daily Profit"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textFontWeight="700" />

                    <TextView
                        android:id="@+id/tvNextClaim"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_gravity="center"
                        android:fontFamily="@font/public_sans"
                        android:text="Next claim available in 12:45:00"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:textFontWeight="600"/>
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
