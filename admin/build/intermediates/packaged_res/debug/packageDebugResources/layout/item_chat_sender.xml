<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:gravity="end"
    android:orientation="horizontal"
    android:padding="3dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:gravity="end"
        android:background="#00000000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/rl_sender_bubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_sender"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Reply Preview (Outgoing) -->
            <LinearLayout
                android:id="@+id/ll_reply_sender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#20FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginBottom="6dp"
                android:visibility="gone">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tv_reply_user_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Support"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_reply_msg_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Message preview"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sender_msg"
                android:text=""
                android:textColor="#fff"
                android:maxWidth="220dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_sender_time"
            android:text="10:45 AM"
            android:textSize="10sp"
            android:textColor="#ccc"
            android:layout_marginTop="2dp"
            android:layout_gravity="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>