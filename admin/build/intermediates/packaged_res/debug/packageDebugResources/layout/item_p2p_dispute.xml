<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_p2p_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="P2P Dispute"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:fontFamily="@font/public_sans"/>

            <TextView
                android:id="@+id/tv_p2p_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/error_red"
                android:fontFamily="@font/public_sans"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_p2p_parties"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buyer: --- | Seller: ---"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tv_p2p_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Proof Ref: ---"
            android:textSize="11sp"
            android:textColor="@color/primary_purple"
            android:textStyle="bold"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tv_p2p_commission"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System Fee: 0%"
            android:textSize="10sp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="2dp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_p2p_chat"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Support Chat"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/primary_purple"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="@font/public_sans"
                app:icon="@android:drawable/ic_menu_help"
                app:iconSize="14dp"
                app:iconPadding="4dp"
                app:iconTint="@color/primary_purple"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_p2p_cancel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/error_red"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="@font/public_sans"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_p2p_release"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Release"
                android:backgroundTint="@color/secondary_green"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/public_sans"
                app:cornerRadius="8dp"
                app:elevation="0dp"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
