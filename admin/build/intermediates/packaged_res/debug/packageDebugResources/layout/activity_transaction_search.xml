<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_gray">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="0dp">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Transaction Lookup"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:fontFamily="@font/public_sans"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure Transaction Verification"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/primary_purple"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_transaction_id"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Scan or Enter Protocol ID"
                    android:background="@null"
                    android:padding="12dp"
                    android:textSize="13sp"
                    android:fontFamily="@font/public_sans"
                    android:inputType="text"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_search"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Verify"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/primary_purple"
                    android:layout_marginEnd="8dp"
                    app:elevation="0dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_lookup_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="System idle - awaiting ID"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:layout_marginTop="10dp"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/public_sans"
            android:textAllCaps="true"
            android:letterSpacing="0.02"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/container_result"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <!-- item_request will be inflated here dynamically -->
    </FrameLayout>

</LinearLayout>
