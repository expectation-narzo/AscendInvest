<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:background="@color/primary_light"
                android:padding="10dp"
                app:tint="@color/primary_purple"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.MediumComponent"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_plan_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plan Name"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:fontFamily="@font/public_sans"/>

                <TextView
                    android:id="@+id/tv_plan_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/primary_purple"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:fontFamily="@font/public_sans"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="0.8"
                android:scaleY="0.8"
                app:thumbTint="@color/primary_purple"
                app:trackTint="@color/primary_light"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_plan_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yield metadata summary..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="12dp"
            android:alpha="0.8"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Remove"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/error_red"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="@font/public_sans"
                android:paddingHorizontal="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Configure"
                android:backgroundTint="@color/primary_purple"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/public_sans"
                android:paddingHorizontal="16dp"
                app:cornerRadius="8dp"
                app:elevation="0dp"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
