<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/divider_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <TextView
                android:id="@+id/tv_hist_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="System Event"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:fontFamily="@font/public_sans"
                android:letterSpacing="-0.01"/>

            <TextView
                android:id="@+id/tv_hist_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:fontFamily="@font/public_sans"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hist_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event metadata log"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/public_sans"
            android:layout_marginTop="2dp"
            android:alpha="0.8"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_hist_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFIED"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_green"
                android:background="@color/secondary_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:fontFamily="@font/public_sans"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_hist_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REF: ---"
                android:textSize="9sp"
                android:textColor="@color/text_tertiary"
                android:fontFamily="@font/public_sans"
                android:alpha="0.6"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_hist_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hist_reject"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Reject"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/error_red"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:fontFamily="@font/public_sans"
                android:paddingHorizontal="12dp"
                app:rippleColor="@color/error_light"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hist_approve"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Approve"
                android:backgroundTint="@color/secondary_green"
                android:layout_marginStart="8dp"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/public_sans"
                android:paddingHorizontal="16dp"
                app:cornerRadius="8dp"
                app:elevation="0dp"/>

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
